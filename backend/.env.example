# DATABASE_URL takes precedence when provided. Keep real credentials in the
# repository-root .env file, which is ignored by Git.
DATABASE_URL=postgresql+psycopg://f1rag_app:replace_me@localhost:5433/f1rag_local

# Alternatively, configure the connection from individual values.
POSTGRES_DB=f1rag_local
POSTGRES_USER=f1rag_app
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Notion API configuration. Lists use JSON syntax. Never commit a real token.
NOTION_API_TOKEN=replace_with_a_read_only_integration_token
NOTION_API_VERSION=2026-03-11
NOTION_ALLOWED_PAGE_IDS=[]
NOTION_ALLOWED_DATA_SOURCE_IDS=[]
# Optional context/property mappings, keyed by independently approved IDs.
NOTION_SOURCE_POLICIES={}
