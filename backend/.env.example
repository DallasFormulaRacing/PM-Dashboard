# DATABASE_URL takes precedence when provided. Keep real credentials in the
# repository-root .env file, which is ignored by Git.
DATABASE_URL=postgresql+psycopg://f1rag_app:replace_me@localhost:5433/f1rag_local

# Alternatively, configure the connection from individual values.
POSTGRES_DB=f1rag_local
POSTGRES_USER=f1rag_app
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Notion API configuration. Lists use JSON syntax. Never commit a real token.
NOTION_API_TOKEN=replace_with_a_read_only_integration_token
NOTION_API_VERSION=2026-03-11
NOTION_ALLOWED_PAGE_IDS=[]
NOTION_ALLOWED_DATA_SOURCE_IDS=[]
# Optional context/property mappings, keyed by independently approved IDs.
NOTION_SOURCE_POLICIES={}

# Box API configuration (read-only). Never commit real secrets or tokens.
# developer_token (60-minute smoke test) or oauth (user login via scripts/box_oauth_login.py)
BOX_AUTH_MODE=oauth
# Required: identifies the source Box account on every document (e.g. personal-dev, utd)
BOX_ACCOUNT_LABEL=personal-dev
BOX_CLIENT_ID=replace_with_box_app_client_id
BOX_CLIENT_SECRET=replace_with_box_app_client_secret
BOX_OAUTH_REDIRECT_URI=http://localhost:8765/callback
# BOX_DEVELOPER_TOKEN=replace_only_for_developer_token_mode
# Comma-separated allowlist of approved Box file IDs.
BOX_ALLOWED_FILE_IDS=
# Optional overrides
# BOX_ALLOWED_EXTENSIONS=pdf,docx,md,txt
# BOX_MAX_FILE_BYTES=26214400
# BOX_OAUTH_TOKEN_PATH=backend/.local/box_oauth_tokens.json
