# Copy to .env (local) or /etc/pm-dashboard/{api,worker}.env (VM). Never commit real values.

DATABASE_URL=postgresql+psycopg://pm:pm@localhost:5432/pm_dashboard
# Redis Cloud in production: rediss://<user>:<password>@<host>:<port>/0
REDIS_URL=redis://localhost:6379/0

# Worker only. The API never needs the bot token.
DISCORD_BOT_TOKEN=
# API only, for "Connect Discord" (OAuth2). Endpoints land later.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ORIGINS=["http://localhost:5173"]

# Post channel messages through a webhook under the sender's name and avatar.
# Needs the bot's Manage Webhooks and Read Message History permissions.
USE_WEBHOOKS=true
