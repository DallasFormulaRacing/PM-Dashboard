[Unit]
Description=PM Dashboard API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=app
WorkingDirectory=/srv/pm-dashboard/backend
EnvironmentFile=/etc/pm-dashboard/api.env
ExecStart=/srv/pm-dashboard/backend/.venv/bin/gunicorn app.api.main:app -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
