[Unit]
Description=PM Dashboard Celery worker (Discord delivery)
After=network-online.target
Wants=network-online.target

[Service]
User=app
WorkingDirectory=/srv/pm-dashboard/backend
EnvironmentFile=/etc/pm-dashboard/worker.env
ExecStart=/srv/pm-dashboard/backend/.venv/bin/celery -A app.worker.tasks:celery_app worker -Q discord --concurrency=2 --loglevel=INFO
# Let in-flight sends finish on stop (Celery warm shutdown on SIGTERM).
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
